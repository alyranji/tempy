// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model comments {
  id          Int       @id @default(autoincrement())
  template_id Int
  user_id     Int
  content     String
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  templates   templates @relation(fields: [template_id], references: [id], onDelete: Cascade, map: "fk_comments_template")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_comments_user")

  @@index([template_id], map: "idx_comments_template")
  @@index([user_id], map: "idx_comments_user")
}

model templates {
  id           Int              @id @default(autoincrement())
  title        String           @db.VarChar(255)
  image        String?          @db.VarChar(255)
  description  String
  demo_url     String           @db.VarChar(255)
  slug         String           @unique @db.VarChar(255)
  price        Decimal?         @db.Decimal(10, 2)
  rtl          Boolean          @default(false)
  score        Int?
  sellCount    Int?
  reviewCount  Int?
  status       template_status? @default(active)
  created_at   DateTime?        @default(now()) @db.Timestamp(6)
  updated_at   DateTime?        @default(now()) @db.Timestamp(6)
  categories   Json?            @db.Json
  tags         Json?            @db.Json
  features     Json?            @db.Json
  addons       Json?            @db.Json
  requirements Json?            @db.Json
  comments     comments[]
}

model users {
  id         Int          @id @default(autoincrement())
  password   String       @db.VarChar(255)
  username   String       @db.VarChar(45)
  email      String       @unique @db.VarChar(150)
  phone      String?      @db.VarChar(45)
  firstname  String?      @db.VarChar(45)
  lastname   String?      @db.VarChar(45)
  avatar_url String?      @db.VarChar(45)
  status     user_status? @default(active)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @db.Timestamp(6)
  role       String?      @db.VarChar(45)
  comments   comments[]
}

enum template_status {
  active
  draft
}

enum user_status {
  active
  inactive
  banned
}
